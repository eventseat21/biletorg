# Kopyala: cp .env.example .env  —  sonra gerçek değerleri doldur. .env Git’e girmez.

NODE_ENV=development

# Prisma: Supabase → Connect → Prisma (Transaction pooler, 6543) URI
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# opsiyonel: migrate için doğrudan bağlantı
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Yerel: npm run dev portu (varsayılan 8080) ile aynı olmalı
NEXTAUTH_URL="http://localhost:8080"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# İsteğe bağlı, yeni Supabase “publishable” anahtarları
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email (SMTP)
SMTP_HOST=mail.kurdevents.org
SMTP_PORT=587
SMTP_USER=destek@kurdevents.org
SMTP_PASS=your-mailbox-password
FORM_RECIPIENT_EMAIL=destek@kurdevents.org

# Site adresleri (kurdevents.org = bu proje, kurdevents.com = satış platformu)
NEXT_PUBLIC_ORG_SITE_URL="https://kurdevents.org"
NEXT_PUBLIC_PUBLIC_SITE_URL="https://kurdevents.com"

# Stripe — tek hesap: KurdEvents tahsil eder, organizatöre sonra ödeme yapılır.
# STRIPE_SECRET_KEY: sk_test_... (geliştirme) / sk_live_... (canlı)
# STRIPE_WEBHOOK_SECRET: /api/webhooks/stripe adresine checkout.session.completed +
#   checkout.session.expired olayları için panelin verdiği whsec_... anahtarı
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
