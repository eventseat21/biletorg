# Kopyala: cp .env.example .env  —  sonra gerçek değerleri doldur. .env Git’e girmez.

NODE_ENV=development

# Prisma: Supabase → Connect → Prisma (Transaction pooler, 6543) URI
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# opsiyonel: migrate için doğrudan bağlantı
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Yerel: npm run dev portu (varsayılan 8080) ile aynı olmalı
NEXTAUTH_URL="http://localhost:8080"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# İsteğe bağlı, yeni Supabase “publishable” anahtarları
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=eventseat21@gmail.com
SMTP_PASS=your-app-password

PLATFORM_COMMISSION_PERCENTAGE=5
