generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String?
  image         String?
  phone         String?
  /// USER: normal; ORGANIZER / CHECKER: kayıt sonrası PENDING, admin onayıyla ACTIVE
  role          String    @default("USER")
  /// PENDING | ACTIVE | REJECTED | SUSPENDED
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizer     Organizer?
  ticketChecker TicketChecker?
  orders        Order[]
  tickets       Ticket[]
  passwordResets PasswordReset[]

  @@map("users")
}

model Organizer {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName     String
  /// Firma ünvanından farklıysa (yayında görünecek marka / organ. adı)
  organizationDisplayName String?
  companyEmail    String
  companyPhone    String?
  taxNumber       String?
  website         String?
  description     String?
  logo            String?
  
  address         String?
  city            String?
  country         String?
  postalCode      String?
  
  status          String    @default("PENDING")
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  
  halls           Hall[]
  events          Event[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("organizers")
}

/// Bilet kontrolörü — admin onayından önce User.status = PENDING
model TicketChecker {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  /// PENDING | APPROVED | REJECTED | SUSPENDED
  status    String  @default("PENDING")
  approvedAt   DateTime?
  approvedBy   String?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_checkers")
}

model Hall {
  id            String    @id @default(cuid())
  organizerId   String
  organizer     Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  
  name          String
  description   String?
  address       String?
  capacity      Int       @default(0)
  
  stageWidth    Int       @default(800)
  stageHeight   Int       @default(600)
  
  svgSource     String?
  source        String    @default("manual")
  
  seats         Seat[]
  seatCategories SeatCategory[]
  events        Event[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("halls")
}

model Seat {
  id          String    @id @default(cuid())
  hallId      String
  hall        Hall      @relation(fields: [hallId], references: [id], onDelete: Cascade)
  
  x           Int
  y           Int
  
  row         String
  number      String
  type        String    @default("NORMAL")
  
  width       Int       @default(30)
  height      Int       @default(30)
  shape       String    @default("circle")
  rotation    Int       @default(0)
  
  svgId       String?
  
  tickets     Ticket[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([hallId, row, number])
  @@map("seats")
}

model SeatCategory {
  id          String    @id @default(cuid())
  hallId      String
  hall        Hall      @relation(fields: [hallId], references: [id], onDelete: Cascade)
  
  name        String
  color       String
  description String?
  price       Float?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("seat_categories")
}

model Event {
  id            String    @id @default(cuid())
  organizerId   String
  organizer     Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  
  hallId        String?
  hall          Hall?     @relation(fields: [hallId], references: [id])
  
  title         String
  slug          String    @unique
  description   String?
  image         String?
  category      String?
  
  startDate     DateTime
  endDate       DateTime?
  doorsOpen     DateTime?
  
  status        String    @default("DRAFT")
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  
  ticketCategories TicketCategory[]
  orders        Order[]
  tickets       Ticket[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("events")
}

model TicketCategory {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  price       Float
  
  totalQuantity   Int
  availableQuantity Int
  
  hasSeatSelection Boolean @default(false)
  seatType      String?
  color         String    @default("#3b82f6")
  
  salesStart    DateTime?
  salesEnd      DateTime?
  
  tickets     Ticket[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ticket_categories")
}

model Order {
  id          String    @id @default(cuid())
  orderNumber String    @unique
  
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id])
  
  status      String    @default("PENDING")
  totalAmount Float
  
  platformFee Float     @default(0)
  organizerAmount Float
  
  customerEmail   String
  customerName    String?
  customerPhone   String?
  
  paymentMethod   String?
  paymentStatus   String    @default("PENDING")
  paidAt          DateTime?
  
  tickets     Ticket[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("orders")
}

model Ticket {
  id          String    @id @default(cuid())
  ticketNumber String   @unique
  
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  seatId      String?
  seat        Seat?     @relation(fields: [seatId], references: [id])
  
  status      String    @default("ACTIVE")
  checkedInAt DateTime?
  
  price       Float
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tickets")
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  
  createdAt   DateTime  @default(now())

  @@map("password_resets")
}